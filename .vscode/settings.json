{
    "clangd.arguments":[
        "--header-insertion=never"
    ],
    "cmake.configureEnvironment": {
    "OpenVINO_DIR": "/opt/intel/openvino/runtime/cmake",
    "CMAKE_PREFIX_PATH": "/opt/intel/openvino/runtime/cmake",
    "LD_LIBRARY_PATH": "/opt/intel/openvino/runtime/lib/intel64:${env:LD_LIBRARY_PATH}",
    "PATH": "/opt/intel/openvino/runtime/bin/intel64:${env:PATH}"
    },

    "cmake.environment": {
    "CC": "clang-20",
    "CXX": "clang++-20",
    "LDFLAGS": "-fuse-ld=lld"
    },

    "editor.formatOnSave": true

}